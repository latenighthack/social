{
  "id": null,
  "uid": "social-avatars-v1",
  "title": "Social / Avatars",
  "tags": [
    "social",
    "social-avatars"
  ],
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Mimir",
          "value": "mimir"
        }
      },
      {
        "name": "DS_LOKI",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Loki",
          "value": "loki"
        }
      },
      {
        "name": "DS_TEMPO",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "current": {
          "text": "Tempo",
          "value": "tempo"
        }
      },
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({__name__=~\"social_(feature_enabled|client_feature_reports_total)\"}, application)",
          "refId": "application"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({application=~\"$application\",__name__=~\"social_(feature_enabled|client_feature_reports_total)\"}, environment)",
          "refId": "environment"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "side",
        "label": "Side",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(social_operations_total{application=~\"$application\",environment=~\"$environment\"}, side)",
          "refId": "side"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "platform",
        "label": "Platform",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(social_operations_total{application=~\"$application\",environment=~\"$environment\"}, platform)",
          "refId": "platform"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({application=~\"$application\",__name__=~\"social_(operations_total|login_provider_enabled)\"}, provider)",
          "refId": "provider"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Installed Social dashboards",
      "type": "dashboards",
      "tags": [
        "social"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Explore traces",
      "type": "link",
      "url": "/explore?schemaVersion=1&panes=%7B%22A%22%3A%20%7B%22datasource%22%3A%20%22${DS_TEMPO}%22%2C%20%22queries%22%3A%20%5B%5D%2C%20%22range%22%3A%20%7B%22from%22%3A%20%22now-1h%22%2C%20%22to%22%3A%20%22now%22%7D%7D%7D"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Operations per second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (feature,side,operation) (rate(social_operations_total{application=~\"$application\",environment=~\"$environment\",side=~\"$side\",platform=~\"$platform\",feature=~\"avatars\",provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{feature}} {{side}} {{operation}} {{result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "links": [
            {
              "title": "Social logs and traces",
              "url": "/d/social-avatars-v1?${application:queryparam}&${environment:queryparam}&${side:queryparam}&${platform:queryparam}&${provider:queryparam}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Unexpected error fraction",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Expected denials, cancellations and skipped writes are not unexpected errors. No data is not a health signal.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (feature,side) (rate(social_operations_total{application=~\"$application\",environment=~\"$environment\",side=~\"$side\",platform=~\"$platform\",feature=~\"avatars\",provider=~\"$provider\",outcome=\"error\"}[$__rate_interval])) / sum by (feature,side) (rate(social_operations_total{application=~\"$application\",environment=~\"$environment\",side=~\"$side\",platform=~\"$platform\",feature=~\"avatars\",provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{feature}} {{side}} {{operation}} {{result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "links": [
            {
              "title": "Social logs and traces",
              "url": "/d/social-avatars-v1?${application:queryparam}&${environment:queryparam}&${side:queryparam}&${platform:queryparam}&${provider:queryparam}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Operation outcomes",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (feature,side,operation,result) (increase(social_operations_total{application=~\"$application\",environment=~\"$environment\",side=~\"$side\",platform=~\"$platform\",feature=~\"avatars\",provider=~\"$provider\"}[$__range]))",
          "legendFormat": "{{feature}} {{side}} {{operation}} {{result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [
            {
              "title": "Social logs and traces",
              "url": "/d/social-avatars-v1?${application:queryparam}&${environment:queryparam}&${side:queryparam}&${platform:queryparam}&${provider:queryparam}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "P95 operation latency",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,feature,side,operation) (rate(social_operation_duration_seconds_bucket{application=~\"$application\",environment=~\"$environment\",side=~\"$side\",platform=~\"$platform\",feature=~\"avatars\",provider=~\"$provider\"}[$__rate_interval])))",
          "legendFormat": "{{feature}} {{side}} {{operation}} {{result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "links": [
            {
              "title": "Social logs and traces",
              "url": "/d/social-avatars-v1?${application:queryparam}&${environment:queryparam}&${side:queryparam}&${platform:queryparam}&${provider:queryparam}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Server feature available",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "1 means a server extension is installed. A missing series does not say whether clients use this feature.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (feature) (social_feature_enabled{application=~\"$application\",environment=~\"$environment\",feature=~\"avatars\"})",
          "legendFormat": "{{feature}} {{side}} {{operation}} {{result}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [
            {
              "title": "Social logs and traces",
              "url": "/d/social-avatars-v1?${application:queryparam}&${environment:queryparam}&${side:queryparam}&${platform:queryparam}&${provider:queryparam}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Seconds since latest client report",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Heartbeat every 30 seconds while the client is alive. Missing reports can mean offline clients, a disabled exporter or no clients using this feature.",
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (feature,platform) (social_client_last_report_timestamp_seconds{application=~\"$application\",environment=~\"$environment\",side=~\"$side\",platform=~\"$platform\",feature=~\"avatars\"})",
          "legendFormat": "{{feature}} {{side}} {{operation}} {{result}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "links": [
            {
              "title": "Social logs and traces",
              "url": "/d/social-avatars-v1?${application:queryparam}&${environment:queryparam}&${side:queryparam}&${platform:queryparam}&${provider:queryparam}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none"
      }
    },
    {
      "id": 7,
      "title": "Events, retries and dead letters",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (feature,side,operation,result) (rate(social_events_total{application=~\"$application\",environment=~\"$environment\",side=~\"$side\",platform=~\"$platform\",feature=~\"avatars\",provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{feature}} {{side}} {{operation}} {{result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "links": [
            {
              "title": "Social logs and traces",
              "url": "/d/social-avatars-v1?${application:queryparam}&${environment:queryparam}&${side:queryparam}&${platform:queryparam}&${provider:queryparam}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "P95 reported queue depth",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Distribution over reporting client snapshots. This is not an exact fleet-wide current backlog.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,feature,side) (rate(social_queue_depth_items_bucket{application=~\"$application\",environment=~\"$environment\",side=~\"$side\",platform=~\"$platform\",feature=~\"avatars\"}[$__rate_interval])))",
          "legendFormat": "{{feature}} {{side}} {{operation}} {{result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [
            {
              "title": "Social logs and traces",
              "url": "/d/social-avatars-v1?${application:queryparam}&${environment:queryparam}&${side:queryparam}&${platform:queryparam}&${provider:queryparam}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "P95 reported oldest queue age",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,feature,side) (rate(social_queue_age_seconds_bucket{application=~\"$application\",environment=~\"$environment\",side=~\"$side\",platform=~\"$platform\",feature=~\"avatars\"}[$__rate_interval])))",
          "legendFormat": "{{feature}} {{side}} {{operation}} {{result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "links": [
            {
              "title": "Social logs and traces",
              "url": "/d/social-avatars-v1?${application:queryparam}&${environment:queryparam}&${side:queryparam}&${platform:queryparam}&${provider:queryparam}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Transferred bytes per second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (feature,side,operation) (rate(social_transfer_bytes_sum{application=~\"$application\",environment=~\"$environment\",side=~\"$side\",platform=~\"$platform\",feature=~\"avatars\",provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{feature}} {{side}} {{operation}} {{result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "links": [
            {
              "title": "Social logs and traces",
              "url": "/d/social-avatars-v1?${application:queryparam}&${environment:queryparam}&${side:queryparam}&${platform:queryparam}&${provider:queryparam}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "Correlated diagnostic events",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\".+\"} | json | application=~\"$application\" | environment=~\"$environment\" | feature=~\"avatars\" | side=~\"$side\" | platform=~\"$platform\" | provider=~\"$provider\""
        }
      ],
      "description": "Open a trace_id using the Loki-to-Tempo derived field configured in the pack provisioning example. Credentials and content are excluded.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
